# Copie para .env  ->  cp .env.backend.example .env
# Usado por docker-compose.backend.yml (só o backend / API).
# O .env NUNCA vai para o Git.

# ── Banco de dados (MySQL) ───────────────────────────────────────────────────
# DEIXE JDBC_DATABASE_URL EM BRANCO para usar o MySQL local em container:
#   docker compose -f docker-compose.backend.yml --profile local-db up -d
#
# MySQL gerenciado na Oracle Cloud (MySQL HeatWave, Always Free) — sem IP
# público; acessível só dentro da VCN. Senha entregue fora do repositório.
#JDBC_DATABASE_URL=jdbc:mysql://<endpoint-privado>:3306/pethotel
JDBC_DATABASE_USERNAME=pethotel
JDBC_DATABASE_PASSWORD=troque-esta-senha

# Tamanho do pool Hikari
HIKARI_MAX_POOL_SIZE=5

# ── CORS ─────────────────────────────────────────────────────────────────────
# Origem(ns) do frontend, separadas por vírgula.
# Deploy via Worker:  https://pethotelgo.SEU_USUARIO.workers.dev
CORS_ALLOWED_ORIGINS=https://pethotelgo.SEU_USUARIO.workers.dev

# ── JWT ──────────────────────────────────────────────────────────────────────
# Obrigatório. Gere com:  openssl rand -base64 64
# Precisa decodificar para >= 32 bytes (256 bits).
JWT_SECRET=

# Validade do access token / refresh token em ms (padrões: 1h / 7d)
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000
